{
	"name": "lexgraph-obsidian-plugin",
	"version": "1.2.0",
	"description": "LexGraph: 법률 특화 InfraNodus Advanced Graph View Plugin for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production && npx tailwindcss -i src/styles/globals.css -o styles.css --minify",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src --ext .ts,.tsx",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "legal", "graph", "law", "korean"],
	"author": "",
	"devDependencies": {
		"@testing-library/react": "^14.3.1",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^20.0.0",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"@vitest/coverage-v8": "^1.0.0",
		"autoprefixer": "^10.4.19",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.20.0",
		"jsdom": "^24.0.0",
		"obsidian": "latest",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.3",
		"tslib": "2.4.0",
		"typescript": "^5.3.0",
		"vitest": "^1.0.0"
	},
	"dependencies": {
		"@primer/octicons-react": "^19.9.0",
		"@tailwindcss/container-queries": "^0.1.1",
		"dompurify": "^3.1.4",
		"esbuild-postcss": "^0.0.4",
		"jwt-decode": "^4.0.0",
		"lodash": "^4.17.21",
		"markdown-to-txt": "^2.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"wink-lemmatizer": "^3.0.4"
	}
